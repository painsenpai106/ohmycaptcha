FROM python:3.11-slim

WORKDIR /app

# Install Chromium dependencies and fonts manually (Debian Trixie compatible)
RUN apt-get update && apt-get install -y \
    fonts-unifont \
    fonts-liberation \
    libnss3 \
    libnspr4 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libxkbcommon0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libpango-1.0-0 \
    libcairo2 \
    libasound2 \
    libatspi2.0-0 \
    libdbus-1-3 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir --root-user-action=ignore -r requirements.txt

# Install only the Chromium binary (deps already installed above)
RUN playwright install chromium

COPY . .

EXPOSE 8000
CMD ["python", "main.py"]
